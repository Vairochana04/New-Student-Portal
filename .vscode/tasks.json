{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Portal: 1) Install dependencies (first time only)",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Portal: Backend API (port 8092)",
      "type": "shell",
      "command": "npm run backend",
      "isBackground": true,
      "presentation": { "panel": "new" },
      "problemMatcher": {
        "owner": "portal-backend",
        "pattern": { "regexp": "^([^\\s].*)$", "file": 1, "message": 1 },
        "background": { "activeOnStart": true, "beginsPattern": ".*", "endsPattern": "API backend on port.*" }
      }
    },
    {
      "label": "Portal: Website (port 5188)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "presentation": { "panel": "new" },
      "problemMatcher": {
        "owner": "portal-frontend",
        "pattern": { "regexp": "^([^\\s].*)$", "file": 1, "message": 1 },
        "background": { "activeOnStart": true, "beginsPattern": ".*", "endsPattern": ".*ready in.*" }
      }
    },
    {
      "label": "\u25b6 RUN PORTAL (Backend + Website)",
      "dependsOrder": "parallel",
      "dependsOn": ["Portal: Backend API (port 8092)", "Portal: Website (port 5188)"],
      "problemMatcher": []
    }
  ]
}
